# Database: PostgreSQL connection URL; required in production.
# Local fixture content is used only when NODE_ENV is not production and this is unset.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# Initial admin seed/bootstrap credentials. Use a unique password with at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_NAME="Portfolio Admin"

# Site identity; set to the canonical HTTPS origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email delivery
RESEND_API_KEY=""
CONTACT_TO_EMAIL="you@example.com"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional upload storage
BLOB_READ_WRITE_TOKEN=""

# Optional distributed rate limiting. App falls back to in-memory limits locally.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
